# Default deny: only build inputs and runtime source enter the context.
**
!Dockerfile
!.dockerignore
!client/
client/**
!client/package.json
!client/package-lock.json
!client/index.html
!client/vite.config.js
!client/jsconfig.json
!client/src/
!client/src/**
!client/public/
!client/public/**
!server/
server/**
!server/package.json
!server/package-lock.json
!server/app.js
!server/index.js
!server/config/
!server/config/**
!server/controllers/
!server/controllers/**
!server/middleware/
!server/middleware/**
!server/routes/
!server/routes/**
!server/services/
!server/services/**
!server/utils/
!server/utils/**

# Keep these excluded even when nested in an allowed source directory.
**/node_modules
**/dist
**/build
**/coverage
**/.git
**/.env
**/.env.*
**/.npmrc
**/credentials
**/secrets
**/*credentials*.json
**/*service-account*.json
**/*service_account*.json
**/application_default_credentials.json
**/*.pem
**/*.key
**/*.log
**/.DS_Store
**/test
**/tests
**/__tests__
**/playwright-report
**/test-results
