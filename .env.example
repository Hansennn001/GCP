# Backend and BigQuery configuration. Use a random JWT_SECRET of at least 32 bytes.
# Set NODE_ENV=production when serving the production build (requires client/dist).
NODE_ENV=development
PORT=8080
# Optional comma-separated exact origins. Empty uses same-origin APIs / Vite proxy.
CORS_ORIGINS=
JWT_SECRET=replace_me
GOOGLE_CLOUD_PROJECT=id-fpoc-0608-data-posindo
BIGQUERY_DATASET=sales_dashboard
# Must match the dataset location; Jakarta is the default for the new dataset.
BIGQUERY_LOCATION=asia-southeast2
